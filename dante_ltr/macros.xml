<macros>
    <!-- Tool version follows this repo's dante_ltr scheme: the requirement with
         its leading zero dropped, plus a wrapper-revision digit (0.4.0.4 ->
         4.0.4.x, 0.6.2.0 -> 6.2.0.x). Not the convention used elsewhere in the
         repo, but changing it now would make the version sort below the
         published 4.0.4.2 and Galaxy would offer the older tool as newer. -->
    <token name="@TOOL_VERSION@">6.3.1.1</token>
    <token name="@REQUIREMENT_VERSION@">0.6.3.1</token>
    <!-- Container tag published to GHCR for this release; kept in step with
         @REQUIREMENT_VERSION@. -->
    <token name="@CONTAINER_TAG@">0.6.3.1</token>
    <!-- Both a container and a package requirement. Galaxy prefers the container
         where the job destination sets singularity_enabled, and falls back to
         resolving the conda package where it does not, so servers that cannot run
         containers keep working. The container is the more robust of the two: a
         .sif is one digest-verified file, whereas a conda environment is thousands
         of files hardlinked out of a shared package cache, where a single truncated
         file breaks every environment referencing it at once. 0.6.3.1 exists
         specifically to make this possible - all commands are on PATH without conda
         activation, so the image runs with a cleaned environment as a Galaxy tool container,
         and upstream's release gate runs these wrapper commands inside the image. -->
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@REQUIREMENT_VERSION@">dante_ltr</requirement>
            <container type="singularity">oras://ghcr.io/kavonrtep/dante_ltr/sif:@CONTAINER_TAG@</container>
        </requirements>
    </xml>
    <!-- Error detection. Replaces detect_errors="aggressive", which fails a job on any
         stdout/stderr line matching "error:" (case-insensitive, fatal). mmseqs2 prints
         "there must be an error: N deleted from M that now is empty, but not assigned to
         a cluster" as ordinary clustering chatter - the string is compiled into the
         binary - and that alone marked a completed TideCluster run as failed: exit status
         0, every output written in full. Any wrapper whose program reaches mmseqs2 has
         the same exposure. What is kept is the part that does not misfire: a non-zero
         exit status, plus the out-of-memory patterns, which matter because a worker can
         be OOM-killed without that reaching the exit status. -->
    <xml name="stdio">
        <stdio>
            <exit_code range=":-1" level="fatal"/>
            <exit_code range="1:" level="fatal"/>
            <regex match="MemoryError" source="both" level="fatal_oom"/>
            <regex match="std::bad_alloc" source="both" level="fatal_oom"/>
            <regex match="java.lang.OutOfMemoryError" source="both" level="fatal_oom"/>
            <regex match="Out of memory" source="both" level="fatal_oom"/>
        </stdio>
    </xml>
</macros>